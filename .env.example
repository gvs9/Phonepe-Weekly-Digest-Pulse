# ── Groq LLM ────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# ── PhonePe — Product Identity ──────────────────────────────
APP_NAME=PhonePe
APP_PLAY_STORE_ID=com.phonepe.app
APP_APP_STORE_ID=1170055821
APP_COUNTRY=in

# ── Review Ingestion ─────────────────────────────────────────
REVIEW_WINDOW_WEEKS=12
MAX_REVIEWS_PER_STORE=500

# ── Delivery ─────────────────────────────────────────────────
GMAIL_RECIPIENT=your_email@gmail.com
GOOGLE_DOC_ID=your_google_doc_id

# ── MCP Server Configuration ────────────────────────────────
MCP_SERVER_URL="https://mcp-server2-production-5873.up.railway.app/sse"
MCP_AUTH_TOKEN=your_mcp_auth_token

# ── Exports ──────────────────────────────────────────────────
EXPORT_DIR="data/reviews"
